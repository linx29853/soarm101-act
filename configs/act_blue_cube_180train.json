{
  "version": 1,
  "task": "put the blue cube into the box",
  "dataset": {
    "repo_id": "local/blue_cube_200",
    "root": "data/datasets/blue_cube_200",
    "fps": 30
  },
  "policy": {
    "type": "act",
    "n_obs_steps": 1,
    "chunk_size": 100,
    "n_action_steps": 1,
    "temporal_ensemble_coeff": 0.01,
    "dim_model": 512,
    "n_heads": 8,
    "dim_feedforward": 3200,
    "n_encoder_layers": 4,
    "n_decoder_layers": 1,
    "use_vae": true,
    "latent_dim": 32,
    "n_vae_encoder_layers": 4,
    "dropout": 0.1,
    "kl_weight": 10.0,
    "optimizer_lr": 1e-05,
    "optimizer_lr_backbone": 1e-05,
    "optimizer_weight_decay": 0.0001,
    "pretrained_backbone_weights": "ResNet18_Weights.IMAGENET1K_V1",
    "use_amp": true,
    "push_to_hub": false
  },
  "training": {
    "output_dir": "outputs/train/act_blue_cube_180train_100k",
    "job_name": "act_blue_cube_180train_100k",
    "device": "cuda",
    "batch_size": 4,
    "num_workers": 1,
    "steps": 100000,
    "log_freq": 100,
    "save_freq": 20000,
    "seed": 1000,
    "wandb": false
  }
}
